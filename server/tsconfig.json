{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "rootDir": ".."
  },
  "include": [
    "src",
    "../src/findings.ts",
    "../src/kit/types.ts",
    "../src/kit/sensorState.ts",
    "../src/kit/autonomy.ts",
    "../src/kit/incidents.ts",
    "../src/worlds.ts",
    "../src/sim/shedModel.ts",
    "../src/sim/darknessIndex.ts",
    "../src/sim/powerDay.ts",
    "../src/sim/marsTau.ts"
  ]
}
