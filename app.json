{
  "expo": {
    "name": "DESMAS",
    "slug": "desmas",
    "version": "1.0.0",
    "orientation": "default",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#000000",
    "scheme": "desmas",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "org.desmas.station"
    },
    "android": {
      "package": "org.desmas.station"
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-video"
    ],
    "experiments": {
      "baseUrl": "/DESMAS"
    }
  }
}
